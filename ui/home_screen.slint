import { ScrollView } from "std-widgets.slint";
import { RoomItem } from "models.slint";
import { Theme, CenteredIconPlate, CenteredStatusDot } from "foundation.slint";

component RoomRow inherits Rectangle {
    in property <RoomItem> room;
    callback open(string);

    height: 80px;
    background: touch.pressed ? Theme.activation-soft
        : touch.has-hover ? Theme.surface-soft
        : transparent;
    border-radius: 4px;
    animate background { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 76px;
        spacing: 14px;
        alignment: start;

        CenteredIconPlate {
            icon: @image-url("../assets/icons/layout-grid.svg");
            tint: root.room.has-exception ? Theme.warning : Theme.text-muted;
            plate-color: root.room.has-exception ? #35231e : Theme.surface-raised;
            plate-size: 40px;
            glyph-size: 18px;
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;

            Text {
                text: root.room.name;
                color: Theme.text;
                font-size: 17px;
                font-weight: 500;
            }

            Text {
                text: root.room.summary;
                color: root.room.has-exception ? Theme.warning : Theme.text-muted;
                font-size: 12px;
            }
        }
    }

    Text {
        x: parent.width - self.width - 10px;
        width: 52px;
        height: parent.height;
        text: "View";
        color: touch.has-hover ? Theme.activation-bright : Theme.control-idle;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        height: 1px;
        y: parent.height - 1px;
        x: 64px;
        width: parent.width - 64px;
        background: Theme.line;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(root.room.id); }
    }
}

component Metric inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <image> icon;

    height: 94px;
    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 4px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 14px;
        alignment: start;

        CenteredIconPlate {
            icon: root.icon;
            tint: Theme.text-muted;
            plate-color: Theme.surface;
            plate-size: 40px;
            glyph-size: 20px;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.value;
                color: Theme.text;
                font-size: 25px;
                font-weight: 300;
            }

            Text {
                text: root.label;
                color: Theme.text-muted;
                font-size: 12px;
            }
        }
    }
}

export component HomeView inherits Rectangle {
    in property <[RoomItem]> rooms;
    in property <string> home-status;
    in property <bool> home-has-alert;
    in property <int> active-count;
    in property <int> appliance-count;
    in property <bool> state-known;
    callback open-room(string);

    background: transparent;

    ScrollView {
        mouse-drag-pan-enabled: true;
        width: parent.width;
        height: parent.height;
        viewport-width: self.width;
        viewport-height: max(self.visible-height, content.preferred-height);

        content := VerticalLayout {
            alignment: start;
            padding-left: root.width < 780px ? 22px : Theme.content-pad;
            padding-right: root.width < 780px ? 22px : Theme.content-pad;
            padding-top: 30px;
            padding-bottom: 34px;
            spacing: 24px;

            VerticalLayout {
                spacing: 7px;

                Text {
                    text: "Home";
                    color: Theme.text;
                    font-size: 33px;
                    font-weight: 300;
                }

                HorizontalLayout {
                    visible: root.home-has-alert;
                    height: 22px;
                    spacing: 10px;
                    alignment: start;

                    CenteredStatusDot { alert: root.home-has-alert; }

                    Text {
                        text: root.home-status;
                        color: root.home-has-alert ? Theme.warning : Theme.success;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;

                Metric {
                    value: root.state-known ? root.active-count : "—";
                    label: "Active now";
                    icon: @image-url("../assets/icons/activity.svg");
                }

                Metric {
                    value: root.appliance-count;
                    label: "Discovered appliances";
                    icon: @image-url("../assets/icons/sparkles.svg");
                }
            }

            VerticalLayout {
                spacing: 0px;

                HorizontalLayout {
                    height: 44px;

                    Text {
                        text: "Rooms";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.rooms.length + " spaces";
                        color: Theme.text-muted;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.line-strong;
                }

                if root.rooms.length == 0 : Text {
                    height: 72px;
                    text: "No appliances yet";
                    color: Theme.text-muted;
                    font-size: 15px;
                    vertical-alignment: center;
                }

                for room in root.rooms : RoomRow {
                    room: room;
                    open(id) => { root.open-room(id); }
                }
            }
        }
    }
}
