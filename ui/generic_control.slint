import { GenericControlItem } from "models.slint";
import { Theme, CenteredStatusDot } from "foundation.slint";
import { ModeButton, PowerButton } from "common_controls.slint";
import { ScalarRail, TextCommandButton } from "generic_primitives.slint";
import { DiscreteLevel } from "discrete_level.slint";
import { ChoiceSelector } from "choice_selector.slint";

export component GenericControlRenderer inherits Rectangle {
    in property <GenericControlItem> control;
    in property <bool> compact;
    in property <bool> has-off;
    in property <GenericControlItem> off-control;
    callback set-binary(string, bool);
    callback set-number(string, float);
    callback step-number(string, float);
    callback select-choice(string, string);
    callback invoke-action(string);
    callback submit-text(string, string);

    private property <bool> armed: false;
    private property <int> pending-kind: -1;
    private property <bool> pending-bool;
    private property <float> pending-number;
    private property <string> pending-choice;
    private property <string> pending-text;
    private property <string> gesture-handle;
    private property <string> gesture-off-handle;
    private property <string> pending-number-handle;
    private property <string> local-text: root.control.value-text;
    private property <length> base-height: root.compact ? 48px
        : root.control.kind == 0 || root.control.kind == 2 ? 78px
        : root.control.kind == 1 ? 106px
        : root.control.kind == 3 ? 112px
        : root.control.kind == 5 ? 104px
        : 70px;

    changed control => {
        if (root.armed && root.pending-kind == 2 && root.pending-number-handle != root.control.handle) {
            root.armed = false;
        }
        if (!root.armed) {
            root.local-text = root.control.value-text;
        }
    }

    function stage-binary(value: bool) {
        if (root.control.treatment == 0) {
            root.set-binary(root.control.handle, value);
        } else {
            root.pending-kind = 0;
            root.pending-bool = value;
            root.armed = true;
        }
    }

    function stage-number(value: float, discrete: bool) {
        if (root.control.treatment == 0) {
            if (discrete) {
                root.step-number(root.control.handle, value);
            } else {
                root.set-number(root.control.handle, value);
            }
        } else {
            root.pending-kind = discrete ? 2 : 1;
            root.pending-number-handle = root.gesture-handle;
            root.pending-number = value;
            root.armed = true;
        }
    }

    function stage-choice(value: string) {
        if (root.control.treatment == 0) {
            root.select-choice(root.control.handle, value);
        } else {
            root.pending-kind = 3;
            root.pending-choice = value;
            root.armed = true;
        }
    }

    height: root.base-height + (root.armed ? 50px : 0px);
    background: transparent;

    content := VerticalLayout {
        padding-left: root.compact ? 0px : 16px;
        padding-right: root.compact ? 0px : 16px;
        padding-top: root.compact ? 0px : 11px;
        padding-bottom: root.compact ? 0px : 11px;
        spacing: root.compact ? 0px : 8px;

        if !(root.compact && root.control.kind == 3) : HorizontalLayout {
            height: root.control.kind == 0 || root.control.kind == 2 ? 48px : 30px;
            spacing: 12px;

            if !root.compact : Text {
                text: root.control.kind == 4 ? "" : root.control.label;
                color: Theme.text;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.control.kind != 2 && root.control.kind != 3 : Text {
                text: root.control.value-text;
                color: root.control.needs-attention ? Theme.warning : Theme.text-muted;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
                max-width: 180px;
                overflow: elide;
            }

            if root.control.kind == 0 : PowerButton {
                checked: root.control.bool-value;
                enabled: root.control.writable && root.control.availability != 2;
                toggled(value) => { root.stage-binary(value); }
            }

            if root.control.kind == 2 : DiscreteLevel {
                horizontal-stretch: 1;
                label: root.control.label;
                binding: root.control.handle + ":" + (root.has-off ? root.off-control.handle : "");
                model-value: root.has-off && root.off-control.has-value && !root.off-control.bool-value
                    ? 0 : root.control.number-value;
                has-value: root.control.has-value
                    || (root.has-off && root.off-control.has-value && !root.off-control.bool-value);
                minimum: root.control.minimum;
                maximum: root.control.maximum;
                step: root.control.step;
                includes-off: root.has-off;
                off-enabled: root.off-control.writable && root.off-control.availability != 2;
                enabled: root.control.writable && root.control.availability != 2;
                started => {
                    root.gesture-handle = root.control.handle;
                    root.gesture-off-handle = root.has-off ? root.off-control.handle : "";
                }
                selected(value) => {
                    if (value == 0 && root.gesture-off-handle != "") {
                        root.invoke-action(root.gesture-off-handle);
                    } else if (root.control.treatment == 0) {
                        root.step-number(root.gesture-handle, value);
                    } else {
                        root.stage-number(value, true);
                    }
                }
            }

            if root.control.kind == 4 : TextCommandButton {
                label: root.control.treatment == 2 ? "Arm" : root.control.label;
                enabled: root.control.writable && root.control.availability != 2;
                guarded: root.control.treatment == 2;
                clicked => {
                    if (root.control.treatment == 0) {
                        root.invoke-action(root.control.handle);
                    } else {
                        root.pending-kind = 4;
                        root.armed = true;
                    }
                }
            }

            if root.control.kind == 7 : CenteredStatusDot {
                alert: root.control.availability == 2;
            }
        }

        if root.control.kind == 1 : ScalarRail {
            model-value: root.control.number-value;
            minimum: root.control.minimum;
            maximum: root.control.maximum;
            enabled: root.control.writable && root.control.availability != 2;
            released(value) => { root.stage-number(value, false); }
        }

        if root.control.kind == 3 : HorizontalLayout {
            height: 48px;
            spacing: 7px;

            if root.control.choices.length == 2 : ChoiceSelector {
                choices: root.control.choices;
                label: root.control.label;
                enabled: root.control.writable && root.control.availability != 2;
                selected(id) => { root.stage-choice(id); }
            }
            if root.control.choices.length != 2 : HorizontalLayout {
                spacing: 7px;
                for choice in root.control.choices : ModeButton {
                    label: choice.label;
                    active: choice.selected;
                    enabled: root.control.writable && root.control.availability != 2;
                    clicked => { root.stage-choice(choice.id); }
                }
            }
        }

        if root.control.kind == 5 : HorizontalLayout {
            height: 38px;
            spacing: 8px;

            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-soft;
                border-width: 1px;
                border-color: Theme.line-strong;
                border-radius: 4px;

                TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text <=> root.local-text;
                    color: Theme.text;
                    selection-background-color: Theme.activation-pressed;
                    selection-foreground-color: Theme.activation-bright;
                    font-size: 13px;
                    single-line: true;
                    enabled: root.control.writable && root.control.availability != 2;
                    vertical-alignment: center;
                }
            }

            TextCommandButton {
                label: "Apply";
                enabled: root.control.writable && root.control.availability != 2;
                clicked => {
                    if (root.control.treatment == 0) {
                        root.submit-text(root.control.handle, root.local-text);
                    } else {
                        root.pending-kind = 5;
                        root.pending-text = root.local-text;
                        root.armed = true;
                    }
                }
            }
        }

        if root.armed : HorizontalLayout {
            height: 38px;
            spacing: 8px;
            alignment: end;

            TextCommandButton {
                label: "Cancel";
                clicked => {
                    root.armed = false;
                    root.local-text = root.control.value-text;
                }
            }

            TextCommandButton {
                label: root.control.treatment == 2 ? "Execute" : "Confirm";
                guarded: root.control.treatment == 2;
                clicked => {
                    if (root.pending-kind == 0) {
                        root.set-binary(root.control.handle, root.pending-bool);
                    } else if (root.pending-kind == 1) {
                        root.set-number(root.control.handle, root.pending-number);
                    } else if (root.pending-kind == 2) {
                        root.step-number(root.pending-number-handle, root.pending-number);
                    } else if (root.pending-kind == 3) {
                        root.select-choice(root.control.handle, root.pending-choice);
                    } else if (root.pending-kind == 4) {
                        root.invoke-action(root.control.handle);
                    } else if (root.pending-kind == 5) {
                        root.submit-text(root.control.handle, root.pending-text);
                    }
                    root.armed = false;
                }
            }
        }
    }

    if !root.compact : Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.line;
    }
}
