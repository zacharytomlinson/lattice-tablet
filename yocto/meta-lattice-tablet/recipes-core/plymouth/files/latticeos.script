Window.SetBackgroundTopColor(0.027, 0.043, 0.051);
Window.SetBackgroundBottomColor(0.027, 0.043, 0.051);

lattice.image = Image("latticeos-boot.png");
lattice.sprite = Sprite(lattice.image);
lattice.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - lattice.image.GetWidth() / 2);
lattice.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - lattice.image.GetHeight() / 2);

fun refresh_callback()
  {
    lattice.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - lattice.image.GetWidth() / 2);
    lattice.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - lattice.image.GetHeight() / 2);
  }

Plymouth.SetRefreshFunction(refresh_callback);
