[Unit]
Description=Lattice tablet kiosk
Wants=weston.service
After=weston.service
Before=graphical.target
StartLimitIntervalSec=0

[Service]
Type=notify
User=weston
Group=weston
Environment=WAYLAND_DISPLAY=/run/wayland-0
Environment=XDG_RUNTIME_DIR=/run
Environment=XDG_CONFIG_HOME=/var/lib/lattice-tablet/config
Environment=SLINT_SCALE_FACTOR=1.8
ExecStart=/usr/bin/lattice-tablet
Restart=always
RestartSec=1
TimeoutStartSec=30
WatchdogSec=20
NotifyAccess=main
StateDirectory=lattice-tablet
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical.target
